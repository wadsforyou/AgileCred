{
  "name": "BranchLocation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Location Name"
    },
    "type": {
      "type": "string",
      "enum": [
        "Office",
        "Service Area"
      ],
      "title": "Location Type",
      "default": "Office"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "lat": {
      "type": "number",
      "title": "Latitude"
    },
    "lng": {
      "type": "number",
      "title": "Longitude"
    },
    "city": {
      "type": "string",
      "title": "City"
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "map_visible": {
      "type": "boolean",
      "title": "Visible on Public Map",
      "default": true
    }
  },
  "required": [
    "name",
    "type"
  ]
}