{
  "name": "AdminNotification",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "title": "Type",
      "description": "e.g. new_application, new_enquiry, status_change, system_alert"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "link": {
      "type": "string",
      "title": "Link",
      "description": "Admin path to the related record"
    },
    "is_read": {
      "type": "boolean",
      "title": "Read",
      "default": false
    }
  },
  "required": [
    "type",
    "title",
    "message"
  ]
}